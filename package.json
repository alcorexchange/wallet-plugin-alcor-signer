{
  "name": "@alcorexchange/wallet-plugin-alcor-signer",
  "version": "0.1.0",
  "description": "Alcor Signer wallet plugin for WharfKit Session Kit: a passkey wallet for WAX, Telos, XPR Network and Vaulta",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
