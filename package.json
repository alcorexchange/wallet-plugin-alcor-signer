{
  "name": "@alcorexchange/wallet-plugin-alcor-signer",
  "version": "0.1.0",
  "description": "Alcor Signer wallet plugin for WharfKit Session Kit: a passkey wallet for WAX, Telos, XPR Network and Vaulta",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/alcorexchange/wallet-plugin-alcor-signer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alcorexchange/wallet-plugin-alcor-signer.git"
  },
  "bugs": "https://github.com/alcorexchange/wallet-plugin-alcor-signer/issues",
  "keywords": [
    "wharfkit",
    "wallet-plugin",
    "antelope",
    "wax",
    "passkey",
    "alcor"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p .",
    "prepublishOnly": "yarn build",
    "test": "yarn build && node --test 'tests/*.test.mjs'",
    "example": "node example/serve.mjs"
  },
  "peerDependencies": {
    "@wharfkit/session": "^1.6.0"
  },
  "devDependencies": {
    "@wharfkit/session": "1.6.1",
    "@wharfkit/web-renderer": "1.4.3",
    "esbuild": "0.27.2",
    "typescript": "5.9.3"
  }
}
